[Unit]
Description=AdKiller-AI Telegram release updater (%f)
Wants=network-online.target
After=network-online.target docker.service

[Service]
WorkingDirectory=%f
ExecStart=/usr/bin/python3 -m adkiller.updater
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=adkiller-updater-%i
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# =========================================================
# 🛡 AI-智能广告杀手 开源自托管版 — 推荐直接运行 bash setup.sh 免 nano 引导配置！
# 启动后也可直接私聊机器人 /start 点按钮配置/更换 AI 接口与 API Key（热生效，无需重启）。
# 不填 AI_API_KEY 也能以「纯本地基础防护模式」运行；填入即可解锁 AI 语义 + 识图。
# =========================================================

# 1. [必填] 去 @BotFather 新建机器人拿到的 Token（整个服务只需配这一次）
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. [强烈建议填写] 超级管理员 Telegram 纯数字 User ID（不是 @用户名！多个用逗号分隔）
#    获取方法：私聊 @userinfobot，或启动后私聊本机器人发 /start 即可看到「你的用户 ID」
#    留空时，服务器启动日志会打印一个 15 分钟有效的一次性 /claim 口令供部署者认领（单账号输错 5 次自动锁定）
OWNER_IDS=

# 3. [选填·强烈推荐] 任意 OpenAI 兼容接口的 API Key、地址和模型名（只填一个模型！）
#    - 留空 AI_API_KEY → 自动进入「纯本地基础防护模式」（CAS黑库/分层防刷屏/隐藏链/木马拦截/入群验证均可用；本地关键词规则默认关闭，可在 /config 按需开启）
#    - 填入 AI_API_KEY → 启动自动探测多模态识图（支持则自动开启，不支持自动降级纯文本 AI 模式）
#    - 上下文说明：单次无状态判别实测仅消耗约 1.2K~2K 输入 Token（无需超长上下文，任意 8K~128K 轻量模型即绰绰有余）
#
# 常用模型参考（任选其一，或填你自己的 New API / OpenRouter 中转）：
#   [DeepSeek 多模态推荐] AI_BASE_URL=https://api.deepseek.com/v1  | AI_MODEL=deepseek-flash
#   [OpenAI 推荐]        AI_BASE_URL=https://api.openai.com/v1    | AI_MODEL=gpt-5-mini 或 gpt-4.1-mini
#   [通义千问多模态]      AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 | AI_MODEL=qwen-vl-max
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash

# =========================================================
# 以下全为选填（不填也能直接用，群内发 /config 点按钮管理）
# =========================================================

# 只允许指定群使用（逗号分隔，例如 -1001234567890）；留空则所有拉入并给管理员的群都可用
ALLOWED_GROUP_IDS=

# 新接入群的默认设置（上线后可随时在群内 /config 点按钮修改，无需重启）
DEFAULT_SPAM_SCORE=80
DEFAULT_DRY_RUN=false
DEFAULT_FLOOD_WINDOW=8
DEFAULT_FLOOD_MAX=6

# 放行的无害外部内联机器人（逗号分隔，不带 @）
ALLOWED_VIA_BOTS=gif,pic,bing,vid

# SQLite 数据文件路径
DB_PATH=/app/data/adkiller.db
